{
  "name": "bevel",
  "version": "0.1.0",
  "private": true,
  "description": "BEVEL — multi-tenant workspace channels for humans and agents",
  "packageManager": "pnpm@10.15.1",
  "scripts": {
    "dev": "nx run-many -t dev --projects=web,admin,realtime --parallel=3",
    "dev:web": "nx dev web",
    "dev:admin": "nx dev admin",
    "dev:realtime": "nx dev realtime",
    "dev:api": "bash scripts/iterm-tabs/00-api.sh",
    "services:start": "bash scripts/services.sh start",
    "services:stop": "bash scripts/services.sh stop",
    "services:status": "bash scripts/services.sh status",
    "services:monitor": "bash scripts/services.sh monitor",
    "services:urls": "bash scripts/services.sh urls",
    "mcp": "cd services/api && uv run bevel-mcp",
    "build": "nx run-many -t build --all",
    "lint": "nx run-many -t lint --all",
    "typecheck": "nx run-many -t typecheck --all",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,css}\"",
    "bevel": "pnpm exec tsx packages/cli/src/index.ts",
    "doctor": "pnpm bevel doctor",
    "test": "pnpm test:unit && pnpm test:api",
    "test:unit": "pnpm test:vitest && pnpm test:provision && pnpm test:mentions",
    "test:vitest": "pnpm exec vitest run",
    "test:watch": "pnpm exec vitest",
    "test:provision": "pnpm exec tsx packages/tenant-config/src/provision.test.ts",
    "test:mentions": "pnpm exec tsx packages/realtime-client/src/lib/mentions.test.ts",
    "test:api": "cd services/api && uv run pytest -q",
    "sync:agents": "node scripts/sync-agents.mjs",
    "mobile:get": "cd apps/mobile && flutter pub get",
    "mobile:test": "cd apps/mobile && flutter test",
    "mobile:run:macos": "cd apps/mobile && flutter run -d macos --dart-define=BEVEL_BASE_URL=https://bevel.is --dart-define=BEVEL_API_URL=https://api.bevel.is --dart-define=BEVEL_WORKSPACE_URL=https://bevel.2x4m.cc",
    "mobile:run:macos:local": "cd apps/mobile && flutter run -d macos --dart-define=BEVEL_BASE_URL=https://bevel.2x4m.lvh.me --dart-define=BEVEL_API_URL=https://api.bevel.lvh.me --dart-define=BEVEL_WORKSPACE_URL=https://bevel.2x4m.lvh.me",
    "mobile:release": "bash scripts/mobile/release.sh",
    "mobile:release:macos": "bash scripts/mobile/release.sh macos",
    "mobile:release:android": "bash scripts/mobile/release.sh android",
    "mobile:release:ios": "bash scripts/mobile/release.sh ios"
  },
  "devDependencies": {
    "@bevel/cli": "workspace:*",
    "@nx/js": "^21.2.0",
    "@nx/next": "^21.2.0",
    "@nx/node": "^21.2.0",
    "nx": "^21.2.0",
    "prettier": "^3.8.3",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "overrides": {
      "next-auth": "5.0.0-beta.31",
      "@colyseus/core": "0.17.44"
    }
  }
}
