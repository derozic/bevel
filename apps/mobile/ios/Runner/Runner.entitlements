<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Shipping entitlements match the current App ID (wildcard team profile).
  Enable Push + Associated Domains on com.derozic.bevel.bevelApp in
  Apple Developer, then copy Runner.entitlements.full.example over this file.
-->
<plist version="1.0">
<dict>
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:bevel.is</string>
		<string>applinks:bevel.is?mode=developer</string>
		<string>applinks:www.bevel.is</string>
		<string>applinks:app.bevel.is</string>
		<string>applinks:bevel.2x4m.cc</string>
		<string>applinks:bevel.2x4m.cc?mode=developer</string>
	</array>
</dict>
</plist>
