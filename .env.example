# ── Platform ────────────────────────────────────────────────────────────────
AUTH_SECRET=change-me-in-production-min-32-chars
NODE_ENV=development

# Tenant app (apps/web)
WEB_PORT=43200
NEXTAUTH_URL=https://bevel.lvh.me
AUTH_URL=https://bevel.lvh.me

# Operator console (apps/admin)
ADMIN_PORT=43201
ADMIN_URL=https://admin.bevel.lvh.me

# Realtime transport (services/realtime)
REALTIME_PORT=43208
REALTIME_URL=https://realtime.bevel.lvh.me
NEXT_PUBLIC_REALTIME_URL=https://realtime.bevel.lvh.me

# Domain service (services/domains)
DOMAINS_PORT=43209
# Production customer CNAME target (Route 53: cname.bevel.is)
BEVEL_CNAME_TARGET=cname.bevel.is
# Local preview still uses lvh.me; production:
# Production (EC2) — prefer AUTH_TRUST_HOST without pinning AUTH_URL so
# same-host OAuth works on both bevel.is and bevel.2x4m.cc. Cross-domain
# hops use Postgres handoff codes (see docs/PRODUCTION_AUTH.md).
# AUTH_TRUST_HOST=true
# BEVEL_PUBLIC_URL=https://bevel.is
# AUTH_COOKIE_DOMAIN=.bevel.is
# ADMIN_URL=https://admin.bevel.is
# BEVEL_API_URL=https://api.bevel.is
# REALTIME_URL=https://realtime.bevel.is
# See docs/PRODUCTION_DNS.md and docs/PRODUCTION_AUTH.md

# Control plane (services/api) + operator/agent internal calls
API_PORT=43203
BEVEL_API_URL=https://api.bevel.lvh.me
NEXT_PUBLIC_BEVEL_API_URL=https://api.bevel.lvh.me
# Hybrid: local UI + LIVE conversations (recommended while building)
# BEVEL_API_URL=https://api.bevel.is
# NEXT_PUBLIC_BEVEL_API_URL=https://api.bevel.is
# NEXT_PUBLIC_REALTIME_URL=https://realtime.bevel.is
# Shared secret for admin proxy + fleet writes + auth handoff issue (1Password)
FLEET_INTERNAL_API_KEY=

# BlueBubbles iMessage (local Mac only — see docs/BLUEBUBBLES_IMESSAGE.md)
# BLUEBUBBLES_URL=http://127.0.0.1:1234
# BLUEBUBBLES_PASSWORD=

# Slack deep integration (see docs/SLACK_INTEGRATION.md + docs/SLACK_MCP.md)
# Create app at https://api.slack.com/apps — internal or Marketplace (required for MCP)
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=
# SLACK_SIGNING_SECRET=
# SLACK_APP_ID=A…
# SLACK_REDIRECT_URI=https://bevel.is/api/integrations/slack/oauth/callback
# local: https://bevel.lvh.me/api/integrations/slack/oauth/callback
# Events Request URL: https://bevel.is/api/integrations/slack/events
# Hosted MCP (agents): https://mcp.slack.com/mcp
# User OAuth (MCP tools): https://slack.com/oauth/v2_user/authorize
# Metadata: https://mcp.slack.com/.well-known/oauth-authorization-server

# Apply secrets local + prod (never commit real values):
#   ./scripts/setup-integrations-env.sh bluebubbles
#   SLACK_CLIENT_ID=… SLACK_CLIENT_SECRET=… SLACK_SIGNING_SECRET=… SLACK_APP_ID=A… \
#     ./scripts/setup-integrations-env.sh all
#   ./scripts/setup-integrations-env.sh validate
# Slack app manifest: scripts/slack-app-manifest.json (create at https://api.slack.com/apps)


# Postgres (FastAPI control plane — required in production; no SQLite)
# DATABASE_URL=postgresql+asyncpg://bevel:bevel@127.0.0.1:5432/bevel
# Production:
# DATABASE_URL=postgresql+asyncpg://bevel:***@127.0.0.1:5432/bevel

# OTP abuse controls (optional overrides)
# OTP_DEST_COOLDOWN_MS=60000
# OTP_IP_MAX_HITS=10
# OTP_IP_WINDOW_MS=3600000

# OAuth (tenant apps inherit tenant auth policy; platform defaults)
# Google Cloud Console → Authorized redirect URIs must include:
#   https://bevel.lvh.me/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GOOGLE_HD=derozic.com

# ── Matrix fabric (optional; dual-write when enabled) ───────────────────────
# MATRIX_ENABLED=0
# MATRIX_HOMESERVER_URL=http://127.0.0.1:8008
# MATRIX_SERVER_NAME=matrix.bevel.is
# MATRIX_AS_TOKEN=
# MATRIX_HS_TOKEN=
# MATRIX_BOT_LOCALPART=bevel_bridge
# MATRIX_SLIDING_SYNC_URL=
# MATRIX_ELEMENT_CALL_URL=
# NEXT_PUBLIC_MATRIX_HOMESERVER_URL=https://matrix.bevel.is
# NEXT_PUBLIC_MATRIX_SERVER_NAME=matrix.bevel.is
AUTH_TRUST_HOST=true
# Share session across org hosts after platform login (local multi-tenant)
AUTH_COOKIE_DOMAIN=.lvh.me
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Declarative tenants root (resolved from monorepo; relative paths are cwd-safe)
BEVEL_TENANTS_ROOT=./tenants

# Doctor offline mode (skip DNS/SSL/health probes)
# BEVEL_DOCTOR_OFFLINE=1

# Dev tenant overrides (comma-separated host → tenant slug)
BEVEL_DEV_TENANTS=bevel.lvh.me:demo,demo.bevel.lvh.me:demo,bevel.acme.lvh.me:acme